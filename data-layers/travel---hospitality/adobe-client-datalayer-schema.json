{
  "loyaltyProgramEnrollment": {
    "type": "event",
    "industries": [
      "Travel & Hospitality"
    ],
    "properties": [
      "eventData.loyaltyProgram.status"
    ],
    "description": "Fires when a customer enrolls in a loyalty program and carries the program status."
  },
  "bookingCompletion": {
    "type": "event",
    "industries": [
      "Travel & Hospitality"
    ],
    "properties": [
      "ecommerce.affiliation",
      "ecommerce.currency",
      "ecommerce.items[].category",
      "ecommerce.items[].id",
      "ecommerce.items[].name",
      "ecommerce.items[].price",
      "ecommerce.items[].quantity",
      "ecommerce.shipping",
      "ecommerce.tax",
      "ecommerce.total",
      "ecommerce.transactionID",
      "user.loyaltyStatus",
      "user.userID"
    ],
    "description": "Fires when a travel booking is completed and carries the transaction, item, price and loyalty status details."
  }
}